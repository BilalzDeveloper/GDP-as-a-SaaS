# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Pooled Postgres connection (Dashboard → Connect → Transaction pooler).
# Transaction mode is required on Vercel serverless; the app sets
# request.jwt.claims + SET LOCAL ROLE authenticated per transaction, so RLS
# applies to every tenant query (see src/db/rls.ts).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# NEVER add the service_role key here. It must not exist in app runtime env —
# migrations/seeds only (see PLAN.md, stack challenge 1).
